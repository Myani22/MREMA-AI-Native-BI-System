LLM_CONFIG=STANDARD # STANDARD | "" | OLLAMA | GIGACHAT


# Общие настройки LLM
LLM_MODEL=qwen2.5:7b-instruct
LLM_BASE_URL=http://localhost:11434/v1 #http://localhost:11434/v1 (standard), http://localhost:11434 (ollama)
LLM_API_KEY=not-needed
LLM_STRUCTURED_MODE=json_schema #json_schema | json_object | prompt
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_S=120.0
LLM_MAX_RETRIES=2
LLM_BACKOFF_BASE_S=1.0


# Настройки Ollama (LLM_CONFIG=OLLAMA)
# Пустые опции не передаются в payload запроса /api/chat
OLLAMA_NUM_CTX=
OLLAMA_NUM_PREDICT=
OLLAMA_TOP_K=
OLLAMA_TOP_P=
OLLAMA_REPEAT_PENALTY=
OLLAMA_SEED=
OLLAMA_KEEP_ALIVE=5m
OLLAMA_THINK=false


# # Настройки GigaChat (LLM_CONFIG=GIGACHAT)
# GIGACHAT_CREDENTIALS= # имеет приоритет над парой GIGACHAT_CLIENT_ID + GIGACHAT_CLIENT_SECRET
# GIGACHAT_CLIENT_ID=
# GIGACHAT_CLIENT_SECRET=
# GIGACHAT_SCOPE=
# GIGACHAT_AUTH_URL=
# GIGACHAT_API_URL=


# # Отдельный LLM-бэкенд для генерации запросов (опционально)
# SQL_LLM=false
# SQL_LLM_CONFIG=

# SQL_LLM_MODEL=
# SQL_LLM_BASE_URL=

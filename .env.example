# SQL_GIGACHAT_API_URL=


# Настройки хранилища данных и API
DATABASE_URL=postgresql+psycopg://mrema:mrema_dev_password@localhost:5432/mrema
DATABASE_SCHEMA=data
DATA_DIR=
CORS_ORIGINS=*
MAX_UPLOAD_MB=200
# SQL_LLM_STRUCTURED_MODE=
# SQL_LLM_TEMPERATURE=
# SQL_LLM_TIMEOUT_S=
# SQL_LLM_MAX_RETRIES=
# SQL_LLM_BACKOFF_BASE_S=

# # Ollama для SQL (SQL_LLM_CONFIG=OLLAMA)
# SQL_OLLAMA_NUM_CTX=
# SQL_OLLAMA_NUM_PREDICT=
# SQL_OLLAMA_TOP_K=
# SQL_OLLAMA_TOP_P=
# SQL_OLLAMA_REPEAT_PENALTY=
# SQL_OLLAMA_SEED=
